{
  "name": "quizbattle",
  "version": "1.0.0",
  "description": "QuizBattle — a real-time multiplayer quiz game built with Express, Socket.IO and SQLite.",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "local": "node --env-file=.env server.js",
    "local:dev": "node --watch --env-file=.env server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "express": "^4.21.2",
    "google-auth-library": "^10.9.1",
    "socket.io": "^4.8.1"
  },
  "license": "MIT"
}
