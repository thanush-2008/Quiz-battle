# QuizBattle configuration — every value is OPTIONAL.
# Locally you do not need any of these. On a hosting platform, add the ones you
# want in the platform's "Environment Variables" settings page.
# (This file is documentation only; the app does not read a .env file.)

# Port to listen on. Hosting platforms set this automatically — do not hard-code it.
PORT=3000

# Set to "production" when deployed.
NODE_ENV=production

# Set to "true" when the app runs behind a hosting platform's proxy/load balancer
# (Render, Railway, Fly.io, Heroku ...). Lets the per-IP connection limit see real visitor IPs.
TRUST_PROXY=true

# Where the SQLite file lives. Point this at a persistent disk/volume if you want
# finished-game results to survive restarts and redeploys. Default: ./data/quiz.db
# DB_PATH=/var/data/quiz.db

# Game tuning
# MAX_PLAYERS=20
# MIN_PLAYERS=1
# QUESTIONS_PER_GAME=5
# QUESTION_SECONDS=15
# REVEAL_SECONDS=5

# Safety limits
# MAX_ROOMS=500
# MAX_CONNECTIONS_PER_IP=40

# Only needed if the frontend is served from a DIFFERENT domain than this server.
# Comma-separated list of allowed origins.
# CORS_ORIGIN=https://my-frontend.example.com
