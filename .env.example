# QuizBattle configuration — every value is OPTIONAL.
# Locally you do not need any of these. On a hosting platform, add the ones you
# want in the platform's "Environment Variables" settings page.
# The deployed app reads real environment variables (set them on the hosting site).
# To run locally WITH Google sign-in: copy this file to ".env", fill in
# GOOGLE_CLIENT_ID, then start with  npm run local  (the .env file is git-ignored).

# ---- Sign in with Google (REQUIRED for real sign-in) ------------------------
# Your OAuth "Web application" Client ID from console.cloud.google.com
# (looks like 1234567890-abc123.apps.googleusercontent.com). It is not a secret.
GOOGLE_CLIENT_ID=

# LOCAL TESTING ONLY: shows a fake "pick any name" login so you can try the app
# without Google. It is ignored when NODE_ENV=production. Never set it on the host.
# DEV_LOGIN=true

# Port to listen on. Hosting platforms set this automatically — do not hard-code it.
PORT=3000

# Set to "production" when deployed.
# NODE_ENV=production   (set this on the host, NOT in your local .env)

# Set to "true" when the app runs behind a hosting platform's proxy/load balancer
# (Render, Railway, Fly.io, Heroku ...). Lets the per-IP connection limit see real visitor IPs.
# TRUST_PROXY=true   (set this on the host)

# Where the SQLite file lives. Point this at a persistent disk/volume if you want
# finished-game results to survive restarts and redeploys. Default: ./data/quiz.db
# DB_PATH=/var/data/quiz.db

# Game tuning
# MAX_PLAYERS=20
# MIN_PLAYERS=1
# QUESTIONS_PER_GAME=10
# QUESTION_SECONDS=15
# REVEAL_SECONDS=5

# Safety limits
# MAX_ROOMS=500
# MAX_CONNECTIONS_PER_IP=40

# Only needed if the frontend is served from a DIFFERENT domain than this server.
# Comma-separated list of allowed origins.
# CORS_ORIGIN=https://my-frontend.example.com
